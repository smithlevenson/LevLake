{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "levlake",
    "compatibility_date": "2026-07-29",
    "workers_dev": true,
    "preview_urls": false,
    "assets": {
        "directory": "./public"
    },
    "routes": [
        {
            "pattern": "levlake.us",
            "custom_domain": true
        }
    ]
}